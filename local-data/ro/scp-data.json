      "itemId": "scp-series-ro-004",
      "numericItemId": 4,
      "titleJP": "Totul este mai frumos la Realitatea virtual\u0103",
      "urlEN": "https://scp-wiki.wikidot.com/scp-ro-004",
      "urlJP": "https://scp-romanian.wikidot.com/scp-ro-004",

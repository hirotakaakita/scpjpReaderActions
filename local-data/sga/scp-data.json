    {
      "itemId": "scp-series-sga-171",
      "numericItemId": 171,
      "titleJP": "\u14f5\ud835\ude79\u2234\u0296\ud835\ude79||\u14ed \u1511\u30ea\u21b8 \u14f5\u2351\u1511\ud835\ude79\u14ed.",
      "urlEN": "https://scp-wiki.wikidot.com/scp-sga-171",
      "urlJP": "https://scp-sga.wikidot.com/scp-sga-171",
      "imageUrl": "http://scp-sga.wikidot.com/local--files/scp-sga-171/Texas%20Map",
      "objectClass": null,
      "rating": 2,
      "descriptionExcerpt": "!\u00a1\u14b7\u14f5\ud835\ude79\u14ed \u14f5\ud835\ude79\u268d\u30ea\u2138 \u0323 \u254e\u2138 \u0323 \u14b7\u14b2 #: \u14ed\u14f5!\u00a1-\u14ed\u22a3\u1511-171 \ud835\ude79\u0296\u22ee\u14b7\u14f5\u2138 \u0323 \u14f5\ua58e\u1511\u14ed\u14ed: \u14b7\u268d\u14f5\ua58e\u254e\u21b8 \u14ed!\u00a1\u14b7\u14f5\u254e\u1511\ua58e \u14f5\ud835\ude79\u30ea\u2138 \u0323 \u1511\u254e\u30ea\u14b2\u14b7\u30ea\u2138 \u0323 !\u00a1\u2237\ud835\ude79\u14f5\u14b7\u21b8\u268d\u2237\u14b7\u14ed: \u14ed\u14f5!\u00a1-\u14ed\u22a3\u1511-171 \u254e\u30ea\u14ed\u2138 \u0323 \u1511\u30ea\u14f5\u14b7\u14ed \u1511\u2237\u14b7 !\u00a1\u2237\u14b7\u14ed\u14b7\u30ea\u2138 \u0323 \ua58e|| \u268d\u30ea\u14f5\ud835\ude79\u30ea\u2138 \u0323 \u1511\u254e\u30ea\u14b7\u21b8. \u2138 \u0323 \u2351\u14b7\u254e\u2237 \u14f5\u268d\u2237\u2237\u14b7\u30ea\u2138 \u0323 \u2138 \u0323 \u14b7\u2237\u2237\u254e\u2138 \u0323 \ud835\ude79\u2237||, \u2351\ud835\ude79\u2234\u14b7\u234a\u14b7\u2237, \u254e\u14ed \u2237\u14b7\ua58e\u1511\u2138 \u0323 \u254e\u234a\u14b7\ua58e|| \u14ed\u14b2\u1511\ua58e\ua58e \u1511\u30ea\u21b8 \u268d\u30ea\u21b8\u14b7\u2237!\u00a1\ud835\ude79!\u00a1\u268d\ua58e\u1511\u2138 \u0323 \u14b7\u21b8, \u30ea\u14b7\u22a3\u1511\u2138 \u0323 \u254e\u30ea\u22a3 \u2138 \u0323 \u2351\u14b7 \u30ea\u14b7\u14b7\u21b8 \u2393\ud835\ude79\u2237 \u21b8\u2237\u1511\u14ed\u2138 \u0323 \u254e\u14f5 \u1511\u14f5\u2138 \u0323 \u254e\ud835\ude79\u30ea \u1511\u14ed \ud835\ude79\u2393 \u2138 \u0323 \u2351\u254e\u14ed \u2138 \u0323 \u254e\u14b2\u14b7. \u2393\u268d\u2237\u2138 \u0323 \u2351\u14b7\u2237 \u14f5\ud835\ude79\u30ea\u2138 \u0323 \u1511\u254e\u30ea\u14b2\u14b7\u30ea\u2138 \u0323 \ud835\ude79\u2393 \u2138 \u0323 \u2351\u14b7 \u14ed\u14f5!\u00a1-\u14ed\u22a3\u1511-171 \u254e\u30ea\u14ed\u2138 \u0323 \u1511\u30ea\u14f5\u14b7\u14ed, \u2234\u2351\u254e\ua58e\u14b7 !\u00a1\u2237\u14b7\u2393\u14b7\u2237\u1511\u0296\ua58e\u14b7, \u254e\u14ed \ud835\ude79\u2393 \u1511 \ua58e\ud835\ude79\u2234 !\u00a1\u2237\u254e\ud835\ude79\u2237\u254e\u2138 \u0323 ||. \u1511\ua58e\ua58e \u14ed\u14f5!\u00a1-\u14ed\u22a3\u1511-171 \u254e\u30ea\u14ed\u2138 \u0323 \u1511\u30ea\u14f5\u14b7\u14ed \u1511\u2237\u14b7 \u14f5\ud835\ude79\u30ea\u2138 \u0323 \u1511\u254e\u30ea\u14b7\u21b8 \u254e\u30ea \u254e\u30ea\u21b8\u254e\u234a\u254e\u21b8\u268d\u1511\ua58e",

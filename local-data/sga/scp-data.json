    {
      "itemId": "scp-series-001",
      "numericItemId": 1,
      "titleJP": "\u1511\u2234\u1511\u254e\u2138 \u0323 \u254e\u30ea\u22a3 \u21b8\u14b7-\u14f5\ua58e\u1511\u14ed\u14ed\u254e\u2393\u254e\u14f5\u1511\u2138 \u0323 \u254e\ud835\ude79\u30ea [\u0296\ua58e\ud835\ude79\u14f5\ua58c\u14b7\u21b8]",
      "urlEN": "https://scp-wiki.wikidot.com/scp-001",
      "urlJP": "https://scp-sga.wikidot.com/scp-001",
      "imageUrl": "http://www.scp-wiki.net/local--files/scp-001/fractal001",
      "objectClass": null,
      "rating": null,
      "descriptionExcerpt": "\u2138 \u0323 \u2351\u14b7 \u2393\ud835\ude79\ua58e\ua58e\ud835\ude79\u2234\u254e\u30ea\u22a3 \u2393\u254e\ua58e\u14b7\u14ed \u2351\u1511\u234a\u14b7 \u0296\u14b7\u14b7\u30ea \u14f5\ua58e\u1511\u14ed\u14ed\u254e\u2393\u254e\u14b7\u21b8 \u2138 \u0323 \ud835\ude79!\u00a1 \u14ed\u14b7\u14f5\u2237\u14b7\u2138 \u0323 \u0296|| \ud835\ude79\u2237\u21b8\u14b7\u2237 \ud835\ude79\u2393 \u2138 \u0323 \u2351\u14b7 \u1511\u21b8\u14b2\u254e\u30ea\u254e\u14ed\u2138 \u0323 \u2237\u1511\u2138 \u0323 \ud835\ude79\u2237 \u22a3\u14b7\u30ea\u14b7\u2237\u1511\ua58e \u30ea\ud835\ude79\u2138 \u0323 \u254e\u14f5\u14b7 001-\u1511\ua58e!\u00a1\u2351\u1511: \u254e\u30ea \ud835\ude79\u2237\u21b8\u14b7\u2237 \u2138 \u0323 \ud835\ude79 !\u00a1\u2237\u14b7\u234a\u14b7\u30ea\u2138 \u0323 \ua58c\u30ea\ud835\ude79\u2234\ua58e\u14b7\u21b8\u22a3\u14b7 \ud835\ude79\u2393 \u14ed\u14f5!\u00a1-001 \u2393\u2237\ud835\ude79\u14b2 \u0296\u14b7\u254e\u30ea\u22a3 \ua58e\u14b7\u1511\ua58c\u14b7\u21b8, \u14ed\u14b7\u234a\u14b7\u2237\u1511\ua58e/\u30ea\ud835\ude79 \u2393\u1511\ua58e\u14ed\u14b7 \u14ed\u14f5!\u00a1-001 \u2393\u254e\ua58e\u14b7\u14ed \u2351\u1511\u234a\u14b7 \u0296\u14b7\u14b7\u30ea \u14f5\u2237\u14b7\u1511\u2138 \u0323 \u14b7\u21b8 \u1511\ua58e\ud835\ude79\u30ea\u22a3\u14ed\u254e\u21b8\u14b7 \u2138 \u0323 \u2351\u14b7 \u2138 \u0323 \u2237\u268d\u14b7 \u2393\u254e\ua58e\u14b7/\u2393\u254e\ua58e\u14b7\u14ed. \u1511\ua58e\ua58e \u2393\u254e\ua58e\u14b7\u14ed \u14f5\ud835\ude79\u30ea\u14f5\u14b7\u2237\u30ea\u254e\u30ea\u22a3 \u2138 \u0323 \u2351\u14b7 \u30ea\u1511\u2138 \u0323 \u268d\u2237\u14b7 \ud835\ude79\u2393 \u14ed\u14f5!\u00a1-001, \u254e\u30ea\u14f5\ua58e\u268d\u21b8\u254e\u30ea\u22a3 \u2138 \u0323 \u2351\u14b7 \u21b8\u14b7\u14f5\ud835\ude79||/\u21b8\u14b7\u14f5\ud835\ude79||\u14ed, \u1511\u2237\u14b7 !\u00a1\u2237\ud835\ude79\u2138 \u0323 \u14b7\u14f5\u2138 \u0323 \u14b7\u21b8 \u0296|| \u1511 \u14b2\u14b7\u14b2\u14b7\u2138 \u0323 \u254e\u14f5 \ua58c\u254e\ua58e\ua58e \u1511\u22a3\u14b7\u30ea\u2138 \u0323 \u21b8\u14b7\u14ed\u254e\u22a3\u30ea\u14b7\u21b8 \u2138 \u0323 \ud835\ude79 \u254e\u14b2\u14b2\u14b7\u21b8\u254e\u1511\u2138 \u0323 \u14b7\ua58e|| \u14f5\u1511\u268d\u14ed\u14b7 \u14f5\u1511\u2237\u21b8\u254e\u1511\u14f5 \u1511\u2237\u2237\u14b7\u14ed\u2138 \u0323 \u254e\u30ea \u1511\u30ea|| \u30ea\ud835\ude79\u30ea\u1511\u268d\u2138 \u0323 \u2351\ud835\ude79\u2237\u254e\u2a05\u14b7",

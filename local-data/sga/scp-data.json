    {
      "itemId": "scp-series-173",
      "numericItemId": 173,
      "titleJP": "\u2138 \u0323 \u2351\u14b7 \u14ed\u14f5\u268d\ua58e!\u00a1\u2138 \u0323 \u268d\u2237\u14b7 -",
      "urlEN": "https://scp-wiki.wikidot.com/scp-173",
      "urlJP": "https://scp-sga.wikidot.com/scp-173",
      "imageUrl": "http://www.scp-wiki.net/local--files/scp-173/SCP-173.jpg",
      "objectClass": null,
      "rating": 2,
      "descriptionExcerpt": "\u14ed\u14f5!\u00a1-173 \u254e\u30ea \u14f5\ud835\ude79\u30ea\u2138 \u0323 \u1511\u254e\u30ea\u14b2\u14b7\u30ea\u2138 \u0323. i\u2138 \u0323 \u14b7\u14b2 #: \u14ed\u14f5!\u00a1-173 \ud835\ude79\u0296\u22ee\u14b7\u14f5\u2138 \u0323 \u14f5\ua58e\u1511\u14ed\u14ed: \u14b7\u268d\u14f5\ua58e\u254e\u21b8 \u14ed!\u00a1\u14b7\u14f5\u254e\u1511\ua58e \u14f5\ud835\ude79\u30ea\u2138 \u0323 \u1511\u254e\u30ea\u14b2\u14b7\u30ea\u2138 \u0323 !\u00a1\u2237\ud835\ude79\u14f5\u14b7\u21b8\u268d\u2237\u14b7\u14ed: i\u2138 \u0323 \u14b7\u14b2 \u14ed\u14f5!\u00a1-173 \u254e\u14ed \u2138 \u0323 \ud835\ude79 \u0296\u14b7 \ua58c\u14b7!\u00a1\u2138 \u0323 \u254e\u30ea \u1511 \ua58e\ud835\ude79\u14f5\ua58c\u14b7\u21b8 \u14f5\ud835\ude79\u30ea\u2138 \u0323 \u1511\u254e\u30ea\u14b7\u2237 \u1511\u2138 \u0323 \u1511\ua58e\ua58e \u2138 \u0323 \u254e\u14b2\u14b7\u14ed. W\u2351\u14b7\u30ea !\u00a1\u14b7\u2237\u14ed\ud835\ude79\u30ea\u30ea\u14b7\ua58e \u14b2\u268d\u14ed\u2138 \u0323 \u14b7\u30ea\u2138 \u0323 \u14b7\u2237 \u14ed\u14f5!\u00a1-173'\u14ed \u14f5\ud835\ude79\u30ea\u2138 \u0323 \u1511\u254e\u30ea\u14b7\u2237, \u30ea\ud835\ude79 \u2393\u14b7\u2234\u14b7\u2237 \u2138 \u0323 \u2351\u1511\u30ea 3 \u14b2\u1511|| \u14b7\u30ea\u2138 \u0323 \u14b7\u2237 \u1511\u2138 \u0323 \u1511\u30ea|| \u2138 \u0323 \u254e\u14b2\u14b7 \u1511\u30ea\u21b8 \u2138 \u0323 \u2351\u14b7 \u21b8\ud835\ude79\ud835\ude79\u2237 \u254e\u14ed \u2138 \u0323 \ud835\ude79 \u0296\u14b7 \u2237\u14b7\ua58e\ud835\ude79\u14f5\ua58c\u14b7\u21b8 \u0296\u14b7\u2351\u254e\u30ea\u21b8 \u2138 \u0323 \u2351\u14b7\u14b2. A\u2138 \u0323 \u1511\ua58e\ua58e \u2138 \u0323 \u254e\u14b2\u14b7\u14ed, \u2138 \u0323 \u2234\ud835\ude79 !\u00a1\u14b7\u2237\u14ed\ud835\ude79\u30ea\u14ed \u14b2\u268d\u14ed\u2138 \u0323 \u14b2\u1511\u254e\u30ea\u2138 \u0323 \u1511\u254e\u30ea \u21b8\u254e\u2237\u14b7\u14f5\u2138 \u0323 \u14b7||\u14b7 \u14f5\ud835\ude79\u30ea\u2138 \u0323 \u1511\u14f5\u2138 \u0323 \u2234\u254e\u2138 \u0323 \u2351 \u14ed\u14f5!\u00a1-173 \u268d\u30ea\u2138 \u0323 \u254e\ua58e \u1511\ua58e\ua58e !\u00a1\u14b7\u2237\u14ed\ud835\ude79\u30ea\u30ea\u14b7\ua58e \u2351\u1511\u234a\u14b7 \u234a\u1511\u14f5\u1511\u2138 \u0323 \u14b7\u21b8 \u1511\u30ea\u21b8 \u2237\u14b7\ua58e\ud835\ude79",

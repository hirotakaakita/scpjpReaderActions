    {
      "itemId": "scp-series-sga-002",
      "numericItemId": 2,
      "titleJP": "\u0296\u2237\u1511\u254e\u30ea \u2393\u2237\u14b7\u14b7\u2a05\u14b7",
      "urlEN": "https://scp-wiki.wikidot.com/scp-sga-002",
      "urlJP": "https://scp-sga.wikidot.com/scp-sga-002",
      "imageUrl": null,
      "objectClass": null,
      "rating": 3,
      "descriptionExcerpt": "\u254e\u2138 \u0323 \u14b7\u14b2 #: \u14ed\u14f5!\u00a1-\u14ed\u22a3\u1511-002 \ud835\ude79\u0296\u22ee\u14b7\u14f5\u2138 \u0323 \u14f5\ua58e\u1511\u14ed\u14ed: \u14ed\u1511\u2393\u14b7 \u14ed!\u00a1\u14b7\u14f5\u254e\u1511\ua58e \u14f5\ud835\ude79\u30ea\u2138 \u0323 \u1511\u254e\u30ea\u14b2\u14b7\u30ea\u2138 \u0323 !\u00a1\u2237\ud835\ude79\u14f5\u14b7\u21b8\u268d\u2237\u14b7\u14ed: \u14ed\u14f5!\u00a1-\u14ed\u22a3\u1511-002 \u254e\u14ed \ua58c\u14b7!\u00a1\u2138 \u0323 \u254e\u30ea \u1511 \u14ed\u2138 \u0323 \u1511\u30ea\u21b8\u1511\u2237\u21b8 \u14f5\ud835\ude79\ua58e\u21b8 \u14ed\u2138 \u0323 \ud835\ude79\u2237\u1511\u22a3\u14b7 \u14f5\ud835\ude79\u30ea\u2138 \u0323 \u1511\u254e\u30ea\u14b7\u2237 \u254e\u30ea \u14ed\u254e\u2138 \u0323 \u14b7-47'\u14ed \u14ed\u1511\u2393\u14b7-\u14f5\ua58e\u1511\u14ed\u14ed \u14f5\ud835\ude79\u30ea\u2138 \u0323 \u1511\u254e\u30ea\u14b2\u14b7\u30ea\u2138 \u0323 \u2234\u254e\u30ea\u22a3. \u1511\u14f5\u14f5\u14b7\u14ed\u14ed \u2138 \u0323 \ud835\ude79 \u14ed\u14f5!\u00a1-\u14ed\u22a3\u1511-002 \u254e\u14ed \ua58e\u254e\u14b2\u254e\u2138 \u0323 \u14b7\u21b8 \u2138 \u0323 \ud835\ude79 \u254e\u30ea\u21b8\u254e\u234a\u254e\u21b8\u268d\u1511\ua58e\u14ed \u1511\u14ed\u14ed\u254e\u22a3\u30ea\u14b7\u21b8 \u2138 \u0323 \ud835\ude79 \u0296\u268d\u254e\ua58e\u21b8\u254e\u30ea\u22a3 \u1511 \u2393\ua58e\u1511\u234a\ud835\ude79\u2237 !\u00a1\u2237\ud835\ude79\u2393\u254e\ua58e\u14b7 \u2393\ud835\ude79\u2237 \u2138 \u0323 \u2351\u14b7 \u1511\u30ea\ud835\ude79\u14b2\u1511\ua58e||. \u1511\u2138 \u0323 \ua58e\u14b7\u1511\u14ed\u2138 \u0323 \ud835\ude79\u30ea\u14b7 \u21b8-\u14f5\ua58e\u1511\u14ed\u14ed !\u00a1\u14b7\u2237\u14ed\ud835\ude79\u30ea\u30ea\u14b7\ua58e \u2234\u2351\ud835\ude79 \u2351\u1511\u14ed !\u00a1\u2237\u14b7\u234a\u254e\ud835\ude79\u268d\u14ed\ua58e|| \u14f5\ud835\ude79\u30ea\u14ed\u268d\u14b2\u14b7\u21b8 \u14ed\u14f5!\u00a1-\u14ed\u22a3\u1511-002 \u1511\u30ea\u21b8 \u2237\u14b7\u1511\u14f5\u2138 \u0323 \u14b7\u21b8 !\u00a1\ud835\ude79\u14ed\u254e\u2138 \u0323 \u254e\u234a\u14b7\ua58e|| \u2138 \u0323 \ud835\ude79 \u254e\u2138 \u0323 \u14ed \u2393\ua58e\u1511\u234a\ud835\ude79\u2237 \u254e\u14ed \u2138 \u0323 \ud835\ude79 \u0296\u14b7 \ua58c\u14b7!\u00a1\u2138 \u0323 \ud835\ude79\u30ea-\u2351\u1511\u30ea\u21b8 \u2393\ud835\ude79\u2237 \u2138 \u0323 \u14b7\u14ed\u2138 \u0323 \u254e\u30ea\u22a3",

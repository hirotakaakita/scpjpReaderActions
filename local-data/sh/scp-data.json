    {
      "itemId": "scp-series-sh-016",
      "numericItemId": 16,
      "titleJP": "Raskovnik",
      "urlEN": "https://scp-wiki.wikidot.com/scp-sh-016",
      "urlJP": "https://scp-sh.wikidot.com/scp-sh-016",
      "imageUrl": null,
      "objectClass": "Euclid",
      "rating": 0,
      "descriptionExcerpt": "SCP-016-SH je anomalijska vrsta endemske biljke iz porodice Apiaceae. Stabljka ove biljke je vretenastog oblika, maslinasto zelene boje, \u0161uplja je i grana se. Listovi su tamnozelene do crne boje, krstastog oblika sa srebrnim ivicama. Cvjetovi su \u0161titastog oblika, crvenkaste boje i sli\u010dni su vatri. Korijen je 20 cm dug i sivo-sme\u0111e je boje. Ova biljka rasprostranjena uglavnom na planinskom podru\u010dju zapadnog djela Republike Srbije, ali se tako\u0111e mo\u017ee prona\u010di I na drugim djelovima Balkana.\nSCP-016-",
